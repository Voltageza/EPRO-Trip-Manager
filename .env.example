# Cartrack Fleet API
CARTRACK_BASE_URL=https://fleetapi-za.cartrack.com/rest
CARTRACK_USERNAME=
CARTRACK_PASSWORD=
VEHICLE_REGISTRATION=

# Gmail SMTP (use App Password - https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# Server
PORT=3001

# Cron schedules
SYNC_CRON=0 6 * * *
REMINDER_CRON=0 7 * * *
WEEKLY_REPORT_CRON=0 6 * * 1

# n8n Webhook (To-Do sync)
# NOTE: this URL is resolved BY THE SERVER, not the browser. On the Proxmox
# deployment "localhost" is the app's own container, so use the n8n host's
# name or address (e.g. http://n8n:5678/webhook/...) or every job event fails
# with "fetch failed" and no To-Do task is created.
